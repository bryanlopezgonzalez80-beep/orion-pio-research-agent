# OpenAI (optional; do not commit real secrets)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Research providers (optional)
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=
COURTLISTENER_API_TOKEN=
CORE_API_KEY=
PSYCINFO_API_ENABLED=false
PSYCINFO_API_AUTHORIZED=false
PSYCINFO_API_KEY=
SCOPUS_API_ENABLED=false
SCOPUS_API_AUTHORIZED=false
SCOPUS_API_KEY=
WOS_API_ENABLED=false
WOS_API_AUTHORIZED=false
WOS_API_KEY=
PROQUEST_API_ENABLED=false
PROQUEST_API_AUTHORIZED=false
PROQUEST_API_KEY=

# Local database overrides (optional; defaults to pio_dashboard.db)
PIO_DB_PATH=
ORION_DB_PATH=

# Optional PostgreSQL connection. Leave empty to keep using local SQLite.
# Never commit a real value or expose it in logs, errors, or reports.
DATABASE_URL=

# Orion API (optional). Use explicit comma-separated browser origins.
ORION_ENV=development
ORION_API_KEY=
ORION_API_KEY_SECONDARY=
ORION_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
ORION_RATE_LIMIT_SEARCH_PER_MINUTE=20
ORION_RATE_LIMIT_WRITE_PER_MINUTE=60
ORION_RATE_LIMIT_READ_PER_MINUTE=120

# Optional PubMed / NCBI E-utilities identity and higher request-rate key.
NCBI_EMAIL=
NCBI_API_KEY=

# Deep harvest tuning (safe defaults if omitted).
ORION_OPENALEX_QUERIES_PER_RUN=12
ORION_BACKFILL_TARGET_MONTHS_PER_RUN=12
ORION_BACKFILL_FLOOR_YEAR=1900
ORION_CITATION_MAX_DEPTH=1
ORION_CITATION_MAX_NODES=100
ORION_CITATION_MIN_RELEVANCE=0.65
ORION_INSTITUTION_NAME=
ORION_OPENURL_BASE=
ORION_OPENURL_ENABLED=false
ORION_GEO_PR_QUERIES_PER_RUN=6
ORION_GEO_US_QUERIES_PER_RUN=4
ORION_GEO_LATAM_QUERIES_PER_RUN=3
ORION_GEO_RUNTIME_SECONDS=180
